{
  "openapi": "3.0.3",
  "info": {
    "title": "HomeVault authenticated Vault and Asset API",
    "version": "1.6.0",
    "description": "Create/archive Vault, register/inspect Asset, manage memberships, ordinary attributes, URL/Note Evidence directed Covers Relationships and Reminder lifecycle operations. Reminder action text is plaintext with separate deliberate reads; no scheduler is provided. Relationship removal retains history and both endpoint Assets. Evidence metadata inspection is separate from deliberate content reads; Evidence content is plaintext, never fetched or encrypted. Sign in through /auth/login after /auth/antiforgery bootstrap. Refresh antiforgery after identity changes. Submit the XSRF-TOKEN cookie value in X-XSRF-TOKEN with both HttpOnly cookies on POST, PUT and DELETE. All responses are no-store. Requests are limited to 16 KiB. Unknown JSON fields are rejected. Creation POSTs have no automatic retry or idempotency guarantee; authorized repeated archival succeeds. No account search or global lists. Sensitive attribute operations require the explicitly unlocked serve-encrypted host; only Owners and Administrators may access private values."
  },
  "servers": [{ "url": "https://localhost:7443" }],
  "security": [{ "cookieAuth": [] }],
  "paths": {
    "/api/v1/assets/{assetId}/sensitive-attributes": {
      "get": {
        "operationId": "listSensitiveAttributes",
        "description": "Available only in serve-encrypted mode. Current members receive metadata without values or ciphertext; Cache-Control: no-store.",
        "parameters": [{ "$ref": "#/components/parameters/AssetIdentity" }],
        "responses": {
          "200": { "description": "Visible Sensitive metadata.", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["attributes"], "properties": { "attributes": { "type": "array", "items": { "$ref": "#/components/schemas/SensitiveAttributeMetadata" } } } } } } },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" }, "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/assets/{assetId}/sensitive-attributes/add": {
      "post": {
        "operationId": "addSensitiveAttribute",
        "description": "Encrypted-host only. Owner/Administrator adds explicitly Sensitive text to an Active Vault, with a generated stable ID. No conversion or upsert; no-store responses.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/AssetIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["name", "value", "sensitivity"], "properties": { "name": { "type": "string" }, "value": { "type": "string" }, "sensitivity": { "type": "string", "enum": ["sensitive"] } } } } } },
        "responses": {
          "201": { "description": "Encrypted attribute committed.", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "#/components/schemas/Identity" } } } } } },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" }, "415": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" }, "500": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/assets/{assetId}/sensitive-attributes/{attributeId}/change": {
      "post": {
        "operationId": "changeSensitiveAttribute", "description": "Encrypted-host only. Owner/Administrator replaces text in an Active Vault, retaining identity and label. No-store responses.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/AssetIdentity" }, { "$ref": "#/components/parameters/SensitiveAttributeIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["value"], "properties": { "value": { "type": "string" } } } } } },
        "responses": {
          "204": { "description": "Encrypted replacement committed." },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" }, "415": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" }, "500": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/assets/{assetId}/sensitive-attributes/{attributeId}/remove": {
      "post": {
        "operationId": "removeSensitiveAttribute", "description": "Encrypted-host only. Empty body; Owner/Administrator removes an Active-Vault attribute without decrypting its old value. No-store responses.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/AssetIdentity" }, { "$ref": "#/components/parameters/SensitiveAttributeIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "responses": {
          "204": { "description": "Attribute removed." },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" }, "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/assets/{assetId}/sensitive-attributes/{attributeId}/read": {
      "post": {
        "operationId": "readSensitiveAttribute", "description": "Encrypted-host only. Empty body; deliberate Owner/Administrator read, including Archived Vaults. Authorization precedes decryption. Response is no-store; never log returned text.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/AssetIdentity" }, { "$ref": "#/components/parameters/SensitiveAttributeIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "responses": {
          "200": { "description": "Deliberately authorized plaintext.", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["value"], "properties": { "value": { "type": "string" } } } } } },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" }, "500": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/vaults/{vaultId}/reminders": {
      "post": {
        "operationId": "createReminder",
        "description": "Create Pending Reminder after current writer, Active Vault, actual Asset ownership, action and identity checks. Action remains plaintext in storage and is omitted from metadata. No scheduling or automatic retry.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VaultIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateReminderInput" } } } },
        "responses": {
          "201": { "description": "Pending Reminder committed.", "headers": { "Location": { "description": "Metadata route.", "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reminder" } } } },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" }, "415": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" }, "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/vaults/{vaultId}/reminders/{reminderId}": {
      "get": {
        "operationId": "inspectReminder", "description": "Current member metadata read, including terminal states and Archived Vaults. No action text.",
        "parameters": [{ "$ref": "#/components/parameters/VaultIdentity" }, { "$ref": "#/components/parameters/ReminderIdentity" }],
        "responses": {
          "200": { "description": "Authorized metadata.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reminder" } } } },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" }, "500": { "$ref": "#/components/responses/Problem" }
        }
      },
      "put": {
        "operationId": "updateReminder", "description": "Replace both Pending fields atomically after current writer/Active Vault checks. Terminal state precedes action validation; concurrent edits serialize, last committed edit wins.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VaultIdentity" }, { "$ref": "#/components/parameters/ReminderIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateReminderInput" } } } },
        "responses": {
          "204": { "description": "Both fields committed." },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" }, "415": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" }, "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/vaults/{vaultId}/reminders/{reminderId}/action": {
      "get": {
        "operationId": "readReminderAction", "description": "Deliberate private action read after current membership and actual ownership checks; includes Archived Vaults. Never log returned content.",
        "parameters": [{ "$ref": "#/components/parameters/VaultIdentity" }, { "$ref": "#/components/parameters/ReminderIdentity" }],
        "responses": {
          "200": { "description": "Authorized action text.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReminderAction" } } } },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" }, "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/vaults/{vaultId}/reminders/{reminderId}/complete": {
      "post": {
        "operationId": "completeReminder", "description": "No body. Complete Pending; same-terminal repeat succeeds only after current writer/Active checks. Cancelled yields 409 not_pending.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VaultIdentity" }, { "$ref": "#/components/parameters/ReminderIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "responses": {
          "204": { "description": "Completed or authorized repeat." },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" }, "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/vaults/{vaultId}/reminders/{reminderId}/cancel": {
      "post": {
        "operationId": "cancelReminder", "description": "No body. Cancel Pending; same-terminal repeat succeeds only after current writer/Active checks. Completed yields 409 not_pending.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VaultIdentity" }, { "$ref": "#/components/parameters/ReminderIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "responses": {
          "204": { "description": "Cancelled or authorized repeat." },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" }, "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/vaults/{vaultId}/relationships": {
      "post": {
        "operationId": "createRelationship",
        "description": "Create directed Covers from source policy Asset to target Asset; categories remain caller responsibilities. Caller supplies global id. Within one write transaction check membership, role, Active Vault, both actual endpoint VaultIds, kind/self-link, identity conflict, then active tuple duplicate. Cross-Vault endpoints are unavailable even for members of both Vaults. No reverse link or retry guarantee.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VaultIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRelationshipInput" } } } },
        "responses": {
          "201": { "description": "Active Relationship committed.", "headers": { "Location": { "description": "Individual inspection route.", "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Relationship" } } } },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/vaults/{vaultId}/relationships/{relationshipId}": {
      "get": {
        "operationId": "inspectRelationship",
        "description": "Current members may inspect Active/Removed roots, including Archived Vaults. Verify actual endpoint ownership in a consistent read transaction. No Asset graph or content is returned. Missing/wrong-Vault roots and inaccessible Vaults share unavailable.",
        "parameters": [{ "$ref": "#/components/parameters/VaultIdentity" }, { "$ref": "#/components/parameters/RelationshipIdentity" }],
        "responses": {
          "200": { "description": "Authorized retained metadata.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Relationship" } } } },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      },
      "delete": {
        "operationId": "removeRelationship",
        "description": "Owner/Administrator/Editor on Active Vault only, including repeated removal. Retains root identity/references as Removed; never deletes Assets. No request body. A new id may recreate the same active tuple after removal, but removed ids stay reserved. Missing/wrong-Vault roots share unavailable.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VaultIdentity" }, { "$ref": "#/components/parameters/RelationshipIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "responses": {
          "204": { "description": "Removed, including authorized repeated removal; empty body." },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" }, "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/assets/{assetId}/evidence": {
      "post": {
        "operationId": "addEvidence",
        "description": "Owner/Administrator/Editor on Active Vault only. Caller supplies Asset-local id. Check current access, role, archive, stored state, then label, kind, content, URL format and duplicate id. URL/Note content is plaintext in SQLite and backups; no fetching, uploads or encryption. Preserve exact label/content. Duplicate id conflicts even for identical payload. Response omits content.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/AssetIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddEvidenceInput" } } } },
        "responses": {
          "201": { "description": "Evidence committed; metadata only.", "headers": { "Location": { "description": "Asset-scoped deliberate content-read route.", "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvidenceMetadata" } } } },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      },
      "get": {
        "operationId": "listEvidenceMetadata",
        "description": "Current members, including Archived Vaults. Projects metadata only without loading content. Unordered, unpaginated snapshot; empty array succeeds.",
        "parameters": [{ "$ref": "#/components/parameters/AssetIdentity" }],
        "responses": {
          "200": { "description": "Metadata snapshot.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvidenceList" } } } },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/assets/{assetId}/evidence/{evidenceId}": {
      "delete": {
        "operationId": "removeEvidence",
        "description": "Same atomic current-role and Active-Vault checks as addition. No body accepted. Removes only this Asset's stored entry, never an external resource. Earlier snapshots remain usable. Missing Evidence and missing/inaccessible Asset share unavailable. Reuse of removed ids is permitted.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/AssetIdentity" }, { "$ref": "#/components/parameters/EvidenceIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "responses": {
          "204": { "description": "Stored entry removed; empty body." },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" }, "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/assets/{assetId}/evidence/{evidenceId}/content": {
      "get": {
        "operationId": "readEvidenceContent",
        "description": "Deliberate authorized disclosure of one entry's original content. Current members including Archived Vaults may read. Returns JSON text, never HTML, redirect, download or fetched resource. Clients must render as text. Missing entry and missing/inaccessible Asset share unavailable.",
        "parameters": [{ "$ref": "#/components/parameters/AssetIdentity" }, { "$ref": "#/components/parameters/EvidenceIdentity" }],
        "responses": {
          "200": { "description": "Original content, no-store.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvidenceContent" } } } },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/assets/{assetId}/attributes": {
      "get": {
        "operationId": "listOrdinaryAttributes",
        "description": "Current members may read ordinary attributes, including Archived Vaults. No ordering guarantee. Unsupported stored classifications fail closed before values are read.",
        "parameters": [{ "$ref": "#/components/parameters/AssetIdentity" }],
        "responses": {
          "200": { "description": "Immutable ordinary snapshot, possibly empty.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrdinaryAttributes" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/assets/{assetId}/attributes/add": {
      "post": {
        "operationId": "addOrdinaryAttribute",
        "description": "Owner/Administrator/Editor on Active Vault only. Check access, role, archive, stored state, name, value, explicit ordinary classification, then duplicate. Names trimmed and matched with .NET OrdinalIgnoreCase; value whitespace preserved. Sensitive input rejected. No automatic retry.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/AssetIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddAttributeInput" } } } },
        "responses": {
          "204": { "description": "Attribute committed; empty body." },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/assets/{assetId}/attributes/change": {
      "post": {
        "operationId": "changeOrdinaryAttribute",
        "description": "Same atomic access checks as add. Change existing value only, preserving name spelling and classification. Identical replacement succeeds after access/lifecycle checks. Missing attribute shares unavailable. Never upserts or overwrites Sensitive data.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/AssetIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangeAttributeInput" } } } },
        "responses": {
          "204": { "description": "Value committed; empty body." },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/assets/{assetId}/attributes/remove": {
      "post": {
        "operationId": "removeOrdinaryAttribute",
        "description": "Same atomic access checks as add. Remove by trimmed ordinal-ignore-case name. Missing attribute shares unavailable. Earlier snapshots are not revoked.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/AssetIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RemoveAttributeInput" } } } },
        "responses": {
          "204": { "description": "Removal committed; empty body." },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" }, "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/vaults/{vaultId}/members": {
      "post": {
        "operationId": "addVaultMember",
        "description": "Owner may add any role. Administrator may add Editor/Viewer only and cannot target an existing privileged member. Requires an existing enabled target account; requesting actor comes only from the session. Check requester permission, Active state, target availability, then duplicates within one write transaction. Missing/disabled targets share unavailable. No invitation or account search.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VaultIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddMemberInput" } } } },
        "responses": {
          "204": { "description": "Membership committed; empty body." },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/vaults/{vaultId}/members/{targetActorId}/role": {
      "put": {
        "operationId": "changeVaultMemberRole",
        "description": "Owner may change roles while preserving the last Owner. Administrator requires both old and new roles to be Editor/Viewer. Current authorization precedes archive and target/conflict checks. Authorized unchanged role succeeds only on an Active Vault. Disabled target accounts remain manageable.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VaultIdentity" }, { "$ref": "#/components/parameters/TargetActorIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangeMemberRoleInput" } } } },
        "responses": {
          "204": { "description": "Role committed, including authorized unchanged role; empty body." },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/vaults/{vaultId}/members/{targetActorId}": {
      "delete": {
        "operationId": "removeVaultMember",
        "description": "Owner may remove any member except the last Owner. Administrator may remove only Editor/Viewer. No body is accepted. Removing membership does not delete the account or Assets. Missing target returns unavailable, including repeats; archived writes fail after role checks. Disabled target accounts remain removable.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VaultIdentity" }, { "$ref": "#/components/parameters/TargetActorIdentity" }, { "$ref": "#/components/parameters/Antiforgery" }],
        "responses": {
          "204": { "description": "Membership removed; empty body." },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/vaults/{vaultId}/archive": {
      "post": {
        "operationId": "archiveVault",
        "description": "Archives a Vault for its current Owner. Repeated Owner archival succeeds; other members receive 403 even when already archived. Missing and nonmember receive identical 404. No request body is accepted. Access checks and archival serialize with record writes. No unarchive operation.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [
          { "name": "vaultId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Identity" } },
          { "$ref": "#/components/parameters/Antiforgery" }
        ],
        "responses": {
          "204": { "description": "Archived, including an authorized repeat; empty body." },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/vaults": {
      "post": {
        "operationId": "createVault",
        "description": "Creates a Vault with a server-generated ID and the authenticated account as sole Owner. No Location header: no Vault-read route exists.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Antiforgery" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VaultInput" } } } },
        "responses": {
          "201": { "description": "Created; no Location header.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Vault" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/vaults/{vaultId}/assets": {
      "post": {
        "operationId": "registerAsset",
        "description": "Owner, Administrator or Editor may write an Active Vault. Current membership and lifecycle checks serialize with insertion. Viewer yields 403 even when archived. Missing and inaccessible Vaults both yield identical 404. Server generates the Asset ID.",
        "security": [{ "cookieAuth": [], "antiforgeryCookie": [] }],
        "parameters": [
          { "name": "vaultId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Identity" } },
          { "$ref": "#/components/parameters/Antiforgery" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssetInput" } } } },
        "responses": {
          "201": {
            "description": "Created Asset.",
            "headers": { "Location": { "description": "Relative /api/v1/assets/{server-generated-id} URL.", "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Asset" } } }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/assets/{assetId}": {
      "get": {
        "operationId": "inspectAsset",
        "description": "Any current Vault member may read, including from an Archived Vault. Missing and inaccessible records both yield identical 404. Permissions are queried again on every request.",
        "parameters": [{ "name": "assetId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Identity" } }],
        "responses": {
          "200": { "description": "Authorized metadata.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Asset" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "__Host-HomeVault" },
      "antiforgeryCookie": { "type": "apiKey", "in": "cookie", "name": "__Host-HomeVault-Antiforgery" }
    },
    "parameters": {
      "SensitiveAttributeIdentity": { "name": "attributeId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Identity" } },
      "ReminderIdentity": { "name": "reminderId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Identity" } },
      "RelationshipIdentity": { "name": "relationshipId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Identity" } },
      "EvidenceIdentity": { "name": "evidenceId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Identity" } },
      "AssetIdentity": { "name": "assetId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Identity" } },
      "VaultIdentity": { "name": "vaultId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Identity" } },
      "TargetActorIdentity": { "name": "targetActorId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Identity" } },
      "Antiforgery": { "name": "X-XSRF-TOKEN", "in": "header", "required": true, "schema": { "type": "string" }, "description": "Request token paired with current antiforgery cookie and identity; never log it." }
    },
    "responses": {
      "Problem": { "description": "Safe failure; no input values or exception text. Status matches HTTP. Access checks precede conflict checks.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "SensitiveAttributeMetadata": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "sensitivity"],
        "properties": { "id": { "$ref": "#/components/schemas/Identity" }, "name": { "type": "string" }, "sensitivity": { "type": "string", "enum": ["sensitive"] } }
      },
      "ReminderInstant": { "type": "string", "format": "date-time", "description": "Exact representable UTC instant; explicit Z or numeric offset, seconds, at most seven fractional digits. No timezone inference or precision truncation. Past dates and full year 0001..9999 UTC range allowed.", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?(Z|[+-][0-9]{2}:[0-9]{2})$" },
      "CreateReminderInput": {
        "type": "object", "additionalProperties": false, "required": ["id", "assetId", "action", "dueAt"],
        "properties": { "id": { "$ref": "#/components/schemas/Identity" }, "assetId": { "$ref": "#/components/schemas/Identity" }, "action": { "$ref": "#/components/schemas/Name" }, "dueAt": { "$ref": "#/components/schemas/ReminderInstant" } }
      },
      "UpdateReminderInput": {
        "type": "object", "additionalProperties": false, "required": ["action", "dueAt"],
        "properties": { "action": { "$ref": "#/components/schemas/Name" }, "dueAt": { "$ref": "#/components/schemas/ReminderInstant" } }
      },
      "Reminder": {
        "type": "object", "additionalProperties": false, "required": ["id", "vaultId", "assetId", "dueAt", "status"],
        "properties": { "id": { "$ref": "#/components/schemas/Identity" }, "vaultId": { "$ref": "#/components/schemas/Identity" }, "assetId": { "$ref": "#/components/schemas/Identity" }, "dueAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" }, "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] } }
      },
      "ReminderAction": { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "$ref": "#/components/schemas/Name" } } },
      "CreateRelationshipInput": {
        "type": "object", "additionalProperties": false, "required": ["id", "sourceAssetId", "targetAssetId", "kind"],
        "properties": { "id": { "$ref": "#/components/schemas/Identity" }, "sourceAssetId": { "$ref": "#/components/schemas/Identity" }, "targetAssetId": { "$ref": "#/components/schemas/Identity" }, "kind": { "type": "string", "enum": ["covers"] } }
      },
      "Relationship": {
        "type": "object", "additionalProperties": false, "required": ["id", "vaultId", "sourceAssetId", "targetAssetId", "kind", "status"],
        "properties": { "id": { "$ref": "#/components/schemas/Identity" }, "vaultId": { "$ref": "#/components/schemas/Identity" }, "sourceAssetId": { "$ref": "#/components/schemas/Identity" }, "targetAssetId": { "$ref": "#/components/schemas/Identity" }, "kind": { "type": "string", "enum": ["covers"] }, "status": { "type": "string", "enum": ["active", "removed"] } }
      },
      "AddEvidenceInput": {
        "type": "object", "additionalProperties": false, "required": ["id", "label", "kind", "content"],
        "properties": { "id": { "$ref": "#/components/schemas/Identity" }, "label": { "$ref": "#/components/schemas/Name" }, "kind": { "type": "string", "enum": ["url", "note"] }, "content": { "$ref": "#/components/schemas/Name" } }
      },
      "EvidenceMetadata": {
        "type": "object", "additionalProperties": false, "required": ["id", "label", "kind"],
        "properties": { "id": { "$ref": "#/components/schemas/Identity" }, "label": { "$ref": "#/components/schemas/Name" }, "kind": { "type": "string", "enum": ["url", "note"] } }
      },
      "EvidenceList": {
        "type": "object", "additionalProperties": false, "required": ["evidence"],
        "properties": { "evidence": { "type": "array", "items": { "$ref": "#/components/schemas/EvidenceMetadata" } } }
      },
      "EvidenceContent": {
        "type": "object", "additionalProperties": false, "required": ["content"],
        "properties": { "content": { "$ref": "#/components/schemas/Name" } }
      },
      "AddAttributeInput": {
        "type": "object", "additionalProperties": false, "required": ["name", "value", "sensitivity"],
        "properties": { "name": { "$ref": "#/components/schemas/Name" }, "value": { "$ref": "#/components/schemas/Name" }, "sensitivity": { "type": "string", "enum": ["ordinary"] } }
      },
      "ChangeAttributeInput": {
        "type": "object", "additionalProperties": false, "required": ["name", "value"],
        "properties": { "name": { "$ref": "#/components/schemas/Name" }, "value": { "$ref": "#/components/schemas/Name" } }
      },
      "RemoveAttributeInput": {
        "type": "object", "additionalProperties": false, "required": ["name"],
        "properties": { "name": { "$ref": "#/components/schemas/Name" } }
      },
      "OrdinaryAttributes": {
        "type": "object", "additionalProperties": false, "required": ["attributes"],
        "properties": { "attributes": { "type": "array", "items": { "$ref": "#/components/schemas/AddAttributeInput" } } }
      },
      "VaultRole": { "type": "string", "enum": ["owner", "administrator", "editor", "viewer"] },
      "AddMemberInput": {
        "type": "object", "additionalProperties": false, "required": ["targetActorId", "role"],
        "properties": { "targetActorId": { "$ref": "#/components/schemas/Identity" }, "role": { "$ref": "#/components/schemas/VaultRole" } }
      },
      "ChangeMemberRoleInput": {
        "type": "object", "additionalProperties": false, "required": ["role"],
        "properties": { "role": { "$ref": "#/components/schemas/VaultRole" } }
      },
      "Identity": { "type": "string", "format": "uuid", "description": "Nonzero Guid in hyphenated D format. Response IDs use lowercase hex; either hex case is accepted in routes.", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
      "Name": { "type": "string", "minLength": 1, "pattern": "\\S", "description": "Nonblank private name; whitespace around the name is preserved exactly. Bounded by the total request-byte limit, not truncated." },
      "VaultInput": {
        "type": "object", "additionalProperties": false, "required": ["name", "type"],
        "properties": { "name": { "$ref": "#/components/schemas/Name" }, "type": { "type": "string", "enum": ["personal", "household", "organization"] } }
      },
      "AssetInput": {
        "type": "object", "additionalProperties": false, "required": ["name"],
        "properties": { "name": { "$ref": "#/components/schemas/Name" } }
      },
      "Vault": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "type", "status"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Identity" }, "name": { "$ref": "#/components/schemas/Name" },
          "type": { "type": "string", "enum": ["personal", "household", "organization"] }, "status": { "type": "string", "enum": ["active"] }
        }
      },
      "Asset": {
        "type": "object", "additionalProperties": false, "required": ["id", "vaultId", "name"],
        "properties": { "id": { "$ref": "#/components/schemas/Identity" }, "vaultId": { "$ref": "#/components/schemas/Identity" }, "name": { "$ref": "#/components/schemas/Name" } }
      },
      "Problem": {
        "type": "object", "additionalProperties": false, "required": ["type", "title", "status", "code", "errors"],
        "properties": {
          "type": { "type": "string", "enum": ["about:blank"] }, "title": { "type": "string", "enum": ["Request failed."] },
          "status": { "type": "integer" },
          "code": { "type": "string", "enum": ["invalid_request", "unauthenticated", "forbidden", "unavailable", "conflict", "request_too_large", "unsupported_media_type", "rate_limited", "request_failed", "blank_name", "invalid_type", "identity_conflict", "vault_archived", "invalid_identity", "invalid_role", "duplicate_member", "last_owner", "invalid_name", "invalid_value", "unsupported_sensitivity", "attribute_exists", "blank_label", "invalid_kind", "blank_content", "invalid_url", "evidence_exists", "self_reference", "relationship_exists", "invalid_due_at", "blank_action", "not_pending", "sensitive_unavailable"] },
          "errors": { "type": "object", "description": "Field names mapped to safe error codes. Empty for non-field failures.", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
        }
      }
    }
  }
}
